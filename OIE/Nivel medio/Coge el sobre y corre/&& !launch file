#include <bits/stdc++.h>

using namespace std;

int main() {
  ios::sync_with_stdio(0);
  cin.tie(0);


  int n, k;
  while (cin >> n >> k && n){
    cout << "k: " << k << endl;
    vector<int> res;
    int maxi = -1;
    int cnt = 0;
    for (int i = 0; i < n; i++) {
      int a; cin >> a; maxi = max(maxi, a);
      cnt++;
      cout << "cnt: " << cnt << endl;
      if (cnt == k) {
        res.push_back(maxi);
        maxi = -1;
        cnt = 0;
      }
    }



    cout << res[0];
    for (int i = 1; i < res.size(); i++) {
      cout << ' ' << res[i];
    }
    cout << '\n';

  }

  return 0;
}
