#include <bits/stdc++.h>

using namespace std;

int main() {
  ios::sync_with_stdio(0);
  cin.tie(0);

  int n, k;
  while (cin >> n >> k) {
    int dp[n+1] = {0};
    dp[0] = 1;
    dp[1] = 1;
    for (int i = 1; i < n; i++) {
      for (int j = 1; j <= k; j++) {
        if (i-j <= 0) continue;
        dp[i] += dp[i-j];
      }
    }
    for (int i = 0; i < n; i++) {
      cout << dp[i] << " ";
    }
    cout << endl;
  }
}

